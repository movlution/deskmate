<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <StartupObject>Deskmate.FeatureCheckRunner</StartupObject>
    <ApplicationManifest>..\src\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\src\Deskmate.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs" />
    <Compile Include="*_check.cs" />
    <Compile Include="FeatureCheckRunner.cs" />
    <EmbeddedResource Include="..\src\Deskmate.ico" LogicalName="Deskmate.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
